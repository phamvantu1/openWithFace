<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Profile</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; }
        .profile-container { max-width: 400px; margin: auto; border: 1px solid #ddd; padding: 20px; border-radius: 10px; }
        label { display: block; margin-top: 10px; }
        input { width: 100%; padding: 10px; margin-top: 5px; border: 1px solid #ccc; border-radius: 5px; }
        button { margin-top: 20px; padding: 10px; background-color: #4CAF50; color: white; border: none; border-radius: 5px; cursor: pointer; }
        button:disabled { background-color: #ddd; cursor: not-allowed; }
    </style>
</head>
<body>
    <header style="background-color: #4CAF50; padding: 10px 0; text-align: center;">
        <nav>
            <a href="/" style="margin: 0 15px; color: white; text-decoration: none;">Home</a>
            <a href="/dashboard" style="margin: 0 15px; color: white; text-decoration: none;">Dashboard</a>
            <a href="/card" style="margin: 0 15px; color: white; text-decoration: none;">Card</a>
            <!-- <a href="/users" style="margin: 0 15px; color: white; text-decoration: none;">Users</a> -->
            <a href="/profile" style="margin: 0 15px; color: white; text-decoration: none;">Profile</a>
            <a href="/logout" style="margin: 0 15px; color: white; text-decoration: none;">Logout</a>
        </nav>
    </header>
    <h1>User Profile</h1>

    <div class="profile-container">
        <form id="profileForm">
            <label for="username">Username:</label>
            <input type="text" id="username" disabled />
            <label for="ten">Ten:</label>
            <input type="ten" id="ten" autocomplete="off" />
            <label for="password">Password:</label>
            <input type="password" id="password" />

            <label for="passdoor">Passdoor:</label>
            <input type="password" id="passdoor" />

            <button type="button" id="updateButton" onclick="updateProfile()">Update Profile</button>
        </form>
    </div>

    <script>
        const token = localStorage.getItem('authToken'); // Lấy token từ localStorage

        function getHeaders() {
            return {
                'Authorization': `Bearer ${token}`,
                'Content-Type': 'application/json',
            };
        }

        // Load profile data when the page loads
        document.addEventListener('DOMContentLoaded', getProfile);

        // Fetch profile data
        async function getProfile() {
            try {
                const response = await fetch('/api/getProfile', { method: 'GET', headers: getHeaders() });
                const data = await response.json();

                if (data.status === 'success') {
                    const user = data.data[0];
                    console.log(user);
                    document.getElementById('username').value = user.user;
                    document.getElementById('ten').value = user.ten;
                    document.getElementById('password').value = user.password;
                    document.getElementById('passdoor').value = user.passdoor;
                } else {
                    alert(data.message);
                }
            } catch (error) {
                console.error('Error fetching profile:', error);
            }
        }

        // Update profile data
        async function updateProfile() {
            const password = document.getElementById('password').value;
            const passdoor = document.getElementById('passdoor').value;
            const ten = document.getElementById('ten').value;

            try {
                const response = await fetch('/api/update-profile', {
                    method: 'PUT',
                    headers: getHeaders(),
                    body: JSON.stringify({ password, passdoor, ten })
                });

                const data = await response.json();
                if (data.status === 'success') {
                    alert('Profile updated successfully!');
                    getProfile(); // Reload profile data
                } else {
                    alert(data.message);
                }
            } catch (error) {
                console.error('Error updating profile:', error);
            }
        }
    </script>

</body>
</html>
